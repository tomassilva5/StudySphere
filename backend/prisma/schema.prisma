// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Utilizador {
  id                    String            @id @default(auto()) @map("_id") @db.ObjectId
  nome_utilizador       String            @unique
  email                 String            @unique
  nome_completo         String?
  palavra_passe         String
  criado_em             DateTime          @default(now())
  id_calendario_externo String?
  google_access_token   String?
  google_refresh_token  String?
  eventos               Evento[]
  grupos                GrupoUtilizador[]
  historico             Historico[]
  refresh_tokens        RefreshToken[]
  mensagens_grupo       MensagemGrupo[]
}

model RefreshToken {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  token_hash    String   @unique
  expira_em     DateTime
  utilizador    Utilizador @relation(fields: [utilizador_id], references: [id])
  utilizador_id String   @db.ObjectId
  criado_em     DateTime @default(now())

  @@index([utilizador_id])
}

model Evento {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  titulo               String
  descricao            String?
  data_inicio          DateTime
  data_fim             DateTime
  e_virtual            Boolean
  link_reuniao         String?
  prioridade           prioridade
  estado               estado_evento @default(agendado)
  proprietario         Utilizador    @relation(fields: [utilizador_id], references: [id])
  utilizador_id        String        @db.ObjectId
  categoria            categoria
  etiquetas            String?
  recorrencia          Json?
  sincronizacao_externa Json?
  grupos_evento        EventoGrupo[]
  criado_em            DateTime?     @default(now())

  @@index([utilizador_id, data_inicio, data_fim])
  @@index([utilizador_id, estado])
  @@index([utilizador_id, prioridade])
  @@index([utilizador_id, categoria])
}

model Grupo {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  descricao     String?
  membros       GrupoUtilizador[]
  criado_em     DateTime?         @default(now())
  eventos_grupo EventoGrupo[]
  mensagens     MensagemGrupo[]

  @@index([nome])
}

model EventoGrupo {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  evento     Evento   @relation(fields: [evento_id], references: [id])
  evento_id  String   @db.ObjectId
  grupo      Grupo    @relation(fields: [grupo_id], references: [id])
  grupo_id   String   @db.ObjectId
  criado_em  DateTime @default(now())

  @@unique([evento_id, grupo_id])
}

model GrupoUtilizador {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  grupo         Grupo      @relation(fields: [grupo_id], references: [id])
  grupo_id      String     @db.ObjectId
  utilizador    Utilizador @relation(fields: [utilizador_id], references: [id])
  utilizador_id String     @db.ObjectId
  criado_em     DateTime   @default(now())

  @@unique([grupo_id, utilizador_id])
}

model MensagemGrupo {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  grupo         Grupo      @relation(fields: [grupo_id], references: [id])
  grupo_id      String     @db.ObjectId
  autor         Utilizador @relation(fields: [autor_id], references: [id])
  autor_id      String     @db.ObjectId
  mensagem      String
  criado_em     DateTime   @default(now())

  @@index([grupo_id, criado_em])
  @@index([autor_id])
}

model Conversa {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  nome      String?
  membros   String[]        @db.ObjectId
  tipo      tipo_conversa   @default(direta)
  mensagens Mensagem[]
  criado_em DateTime        @default(now())

  @@index([membros])
}

model Mensagem {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  conversa_id      String    @db.ObjectId
  conversa         Conversa  @relation(fields: [conversa_id], references: [id])
  remetente_id     String    @db.ObjectId
  conteudo         String?
  data_envio       DateTime? @default(now())
  lido_por         String[]  @db.ObjectId
  caminho_ficheiro String?

  @@index([conversa_id, data_envio])
  @@index([lido_por])
}

model Historico {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  utilizador    Utilizador @relation(fields: [utilizador_id], references: [id])
  utilizador_id String     @db.ObjectId
  acao          String
  criado_em     DateTime

  @@index([utilizador_id])
}

enum tipo_conversa {
  direta
  grupo
}

enum categoria {
  Universidade
  Estudo_Individual
  Estudo_Grupo
  Eventos_Pessoais
  Lazer
}

enum estado_evento {
  agendado
  em_andamento
  concluido
  cancelado
}

enum prioridade {
  BAIXA
  MEDIA
  ALTA
}